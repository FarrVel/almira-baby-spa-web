# ============================================================================
# KONFIGURASI ENVIRONMENT - ALMIRA BABY AND KIDS SPA WEB
# Salin file ini menjadi `.env` untuk pengembangan lokal, dan masukkan
# variabel yang sama ke menu Project Settings > Environment Variables di Vercel
# ============================================================================

# 1. Database Cloud SQLite (Turso / LibSQL)
# Gunakan `file:./database/local.db` untuk testing lokal, atau URL Turso untuk Vercel
TURSO_DATABASE_URL=libsql://almira-baby-spa-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 2. Autentikasi & Sesi Panel Admin
JWT_SECRET=ganti_dengan_secret_key_acak_minimal_32_karakter
ADMIN_DEFAULT_USERNAME=admin_almira
# Password asli hanya dipakai saat menjalankan script hash / seeding awal
ADMIN_DEFAULT_PASSWORD=ganti_password_aman

# 3. Penyimpanan Foto Layanan (Pilih salah satu: Vercel Blob atau Cloudinary)
# Opsi A: Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxx_xxxxxxxxxxxxxxxx

# Opsi B: Cloudinary (Opsional jika tidak memakai Vercel Blob)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
